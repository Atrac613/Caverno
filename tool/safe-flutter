#!/usr/bin/env bash
#
# tool/safe-flutter — Flutter wrapper that blocks macOS builds outside
# the canonical worktree.
#
# Why:
#   Multiple git worktrees that each build the macOS app produce multiple
#   Caverno.app bundles claiming com.noguwo.apps.caverno. macOS
#   LaunchServices then routes launchd / XPC requests to whichever copy
#   was registered last, TCC grants drift across helper paths, and the
#   Computer Use helper reports helper_bundle_path_mismatch. This wrapper
#   refuses macOS builds in any worktree that has not been designated as
#   the canonical macOS dev location.
#
# How to designate a worktree as the canonical macOS dev location:
#   touch .macos-canonical
#
# The .macos-canonical sentinel is gitignored so each developer can
# choose their own canonical worktree.
#
# Bypass (e.g., for one-off intentional builds elsewhere):
#   FLUTTER_ALLOW_MACOS_HERE=1 tool/safe-flutter build macos --debug
#
# Cleanup if multiple worktrees have already polluted LaunchServices:
#   tool/macos_dev_preflight.sh
#
# A bypassed macOS build runs that cleanup itself once flutter exits, so the
# stale bundle never outlives the session. Opt out with:
#   CAVERNO_SKIP_MACOS_CLEANUP=1

set -euo pipefail

# Resolve the worktree being built from the current working directory, NOT
# from this script's own path. flutter operates on the project in $PWD, so the
# macOS guard must check that worktree's sentinel. Deriving the worktree from
# ${BASH_SOURCE[0]} silently bypassed the guard when invoked through an
# absolute-path alias (e.g. the documented `caverno-flutter` alias), which
# always resolved to the alias target's worktree regardless of where the build
# actually runs. Fall back to $PWD when not inside a git working tree.
WORKTREE="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || pwd)"

# Detect whether the invocation targets macOS. Only exact-token matches
# qualify so that `--target=lib/main_macos.dart` and similar paths do not
# trigger the guard.
wants_macos=false
prev=""
for arg in "$@"; do
  case "$arg" in
    -dmacos|--device-id=macos|--device=macos)
      wants_macos=true
      ;;
    macos)
      case "$prev" in
        # `flutter build macos`, `flutter run -d macos`, etc.
        build|run|install|attach|test|drive|--device|--device-id|-d)
          wants_macos=true
          ;;
      esac
      ;;
  esac
  prev="$arg"
done

if $wants_macos \
   && [[ "${FLUTTER_ALLOW_MACOS_HERE:-0}" != "1" ]] \
   && [[ ! -f "$WORKTREE/.macos-canonical" ]]
then
  cat <<EOF >&2
Error: macOS builds are blocked in this worktree.
  worktree : $WORKTREE
  reason   : .macos-canonical sentinel not present

Multiple worktrees building macOS produce conflicting Caverno.app
bundles that LaunchServices and TCC cannot distinguish.

To allow macOS builds in this worktree:
  touch "$WORKTREE/.macos-canonical"

To bypass the guard once (without designating this worktree):
  FLUTTER_ALLOW_MACOS_HERE=1 ${BASH_SOURCE[0]##*/} $*

If a prior conflict has already polluted LaunchServices, clean it with:
  $WORKTREE/tool/macos_dev_preflight.sh
EOF
  exit 1
fi

# Inject build provenance (git commit / dirty / build time) so the running
# binary — and every session log it writes — can be traced back to the exact
# source it was built from. Only build-class subcommands accept --dart-define,
# and only they produce a binary, so the injection is scoped to them. Values
# are read at runtime via BuildInfo (lib/core/constants/build_info.dart).
case "${1:-}" in
  run|build|drive|test|attach|install)
    # Inject the environment-owned Firebase defines (relay origin). Without
    # them the Remote Coding relay client resolves to null and push delivery
    # silently no-ops, so warn on the subcommands that produce a binary a
    # human will then test on a device.
    source "$WORKTREE/tool/caverno_dart_defines.sh"
    caverno_load_build_provenance_define_args "$WORKTREE"
    case "${1:-}" in
      run|build) caverno_load_dart_define_args "$WORKTREE" warn ;;
      *) caverno_load_dart_define_args "$WORKTREE" ;;
    esac
    set -- "$@" "${CAVERNO_BUILD_DART_DEFINE_ARGS[@]}"
    if [[ ${#CAVERNO_DART_DEFINE_ARGS[@]} -gt 0 ]]; then
      set -- "$@" "${CAVERNO_DART_DEFINE_ARGS[@]}"
    fi
    ;;
esac

# A bypassed macOS build leaves a second Caverno.app claiming
# com.noguwo.apps.caverno in a worktree that is not the canonical one.
# LaunchServices routes launchd / XPC to whichever copy it indexed last, so
# the Computer Use helper starts reporting helper_bundle_path_mismatch and TCC
# grants drift. Unregister it on the way out rather than leaving the breakage
# for a later session to discover.
macos_cleanup_target=""
if $wants_macos \
   && [[ "${FLUTTER_ALLOW_MACOS_HERE:-0}" == "1" ]] \
   && [[ ! -f "$WORKTREE/.macos-canonical" ]] \
   && [[ "${CAVERNO_SKIP_MACOS_CLEANUP:-0}" != "1" ]]
then
  # macos_dev_preflight.sh preserves --main-worktree and removes every other
  # Caverno*.app it finds. Its default is this script's own parent, which here
  # is the throwaway worktree -- passing that would delete the canonical
  # bundle and keep the stale one. Find the real canonical worktree, and skip
  # the cleanup rather than guess when no worktree claims the sentinel.
  while IFS= read -r line; do
    [[ "$line" == "worktree "* ]] || continue
    candidate="${line#worktree }"
    if [[ -f "$candidate/.macos-canonical" ]]; then
      macos_cleanup_target="$candidate"
      break
    fi
  done < <(git -C "$WORKTREE" worktree list --porcelain 2>/dev/null || true)

  if [[ -z "$macos_cleanup_target" ]]; then
    cat <<'EOF' >&2
safe-flutter: no worktree carries .macos-canonical, so the post-run
  LaunchServices cleanup is skipped -- it cannot tell which Caverno.app to
  keep. Designate one with `touch .macos-canonical`, or clean up afterwards:
    tool/macos_dev_preflight.sh --main-worktree <canonical-worktree>
EOF
  fi
fi

# Delegate to the real flutter. Prefer fvm when the worktree pins a
# Flutter SDK version, so the wrapper matches whatever the project
# expects.
if command -v fvm >/dev/null 2>&1 \
   && { [[ -f "$WORKTREE/.fvmrc" ]] || [[ -d "$WORKTREE/.fvm" ]]; }
then
  flutter_cmd=(fvm flutter)
else
  flutter_cmd=(flutter)
fi

if [[ -z "$macos_cleanup_target" ]]; then
  exec "${flutter_cmd[@]}" "$@"
fi

# Deliberately not exec'd: this shell has to outlive flutter to run the
# cleanup, including when the run ends in a non-zero exit or a Ctrl-C.
cleanup_bypassed_macos_build() {
  local status=$?
  trap - EXIT
  echo >&2
  echo "safe-flutter: bypassed macOS build finished; restoring LaunchServices" >&2
  echo "  to $macos_cleanup_target. Set CAVERNO_SKIP_MACOS_CLEANUP=1 to skip." >&2
  "$WORKTREE/tool/macos_dev_preflight.sh" \
    --main-worktree "$macos_cleanup_target" \
    --skip-clean \
    --skip-kill \
    || echo "safe-flutter: cleanup failed; run tool/macos_dev_preflight.sh by hand." >&2
  exit "$status"
}
trap cleanup_bypassed_macos_build EXIT

"${flutter_cmd[@]}" "$@"
